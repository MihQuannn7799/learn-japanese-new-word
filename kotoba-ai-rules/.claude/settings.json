{
  "permissions": {
    "allow": [
      "Bash(node scripts/check.mjs)",
      "Bash(node scripts/check.mjs:*)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
